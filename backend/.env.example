# 이 파일을 복사해 이름을 .env 로 바꾼 뒤, = 뒤에 값만 채웁니다. .env 는 GitHub에 올리지 않습니다.
# 운영(Cloud Run)에서는 이 값들을 환경변수와 Secret Manager로 넣습니다.

OPENAI_API_KEY=
OPENAI_MODEL=
KAKAO_REST_API_KEY=

# LangSmith 트레이싱(선택). 키가 있으면 자동으로 켜집니다. 끄려면 LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-chatbot

# DB: 비우면 로컬 SQLite 파일(local.db)을 씁니다.
# 운영(Cloud SQL): postgresql+psycopg://사용자:비밀번호@/DB이름?host=/cloudsql/프로젝트:리전:인스턴스
DATABASE_URL=

# 요청 제한 (사용자별 분당·일일, IP별 분당)
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=150
IP_RATE_LIMIT_PER_MINUTE=30

# 웹 서버(BFF)가 보낸 접속자 IP(X-Client-Ip)를 믿을지. 백엔드를 비공개로 잠갔을 때만 true
TRUST_CLIENT_IP_HEADER=false
# 브라우저가 백엔드를 직접 부를 때만 필요한 허용 주소(쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000
